{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MIT Readiness Atlas",
  "version": "0.1.0",
  "identifier": "com.hasto.mitreadinessatlas",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MIT Readiness Atlas",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Education",
    "shortDescription": "Evidence-backed student archetype explorer",
    "longDescription": "Explore eight synthetic student-development archetypes, compare activities locally, and inspect the evidence behind every tier.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
